# Names of every setting the engine reads. No values here; copy to .env and fill locally.
# .env is git-ignored and agents are denied read access to it.

# --- process ---
UMAI_DE_ENV=development
UMAI_DE_LOG_LEVEL=INFO
UMAI_DE_MAX_TIMEOUT_MS=3000
UMAI_DE_DEFAULT_TIMEOUT_MS=1500
UMAI_DE_ALLOW_INLINE_BUNDLES=          # empty → true only in development
UMAI_DE_EXPOSE_DETECT_ENDPOINT=        # empty → true only in development
UMAI_DE_API_TOKEN=                     # bearer token for /v1 routes; required outside development (ADR-0016)

# --- policy service (control plane, ADR-0022; separate process) ---
UMAI_DE_CONTROL_API_TOKEN=            # bearer token for the policy service; required outside development
UMAI_DE_CONTROL_DB_PATH=.data/control.sqlite
UMAI_DE_SIGNING_KEY_FILE=             # Ed25519 private key file (base64) used to sign published versions
UMAI_DE_SIGNING_KEY_ID=

# --- L0 ---
UMAI_DE_TENANT_HMAC_KEYS=            # JSON map tenant_id -> base64 key (dev only; KMS later)
REGEX_TIMEOUT_SECONDS=1              # read by Presidio; integer only
HF_HUB_OFFLINE=1                     # never download models at runtime
UMAI_DE_L0_THREADS=4
UMAI_DE_POPULAR_DOMAINS_FILE=        # optional larger popular-domain list for UNKNOWN_LINK (one domain or rank,domain per line)

# --- L1b decision models (provider registry) ---
UMAI_DE_DECISION_PROVIDERS=          # JSON: {"onprem_decider": {"adapter": "systemone_compatible", "base_url": "...", "model": "..."}, ...}  [not read yet: lands with F2/F3]
TYPESAFE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- L2 asynchronous review worker ---
UMAI_DE_L2_MODELS=                   # JSON: {"gpt_oss_safeguard_20b": {"base_url": "...", "model": "...", "auth_env": "..."}}  [not read yet: lands with F2/F3]
UMAI_DE_EVENT_SINK=sqlite            # memory | sqlite  [not read yet: lands with F2/F3]
UMAI_DE_EVENT_DB=.data/events.sqlite  [not read yet: lands with F2/F3]
UMAI_DE_L2_WORKER_CONCURRENCY=2  [not read yet: lands with F2/F3]
UMAI_DE_L2_CALL_TIMEOUT_S=30  [not read yet: lands with F2/F3]

# --- session history ---
UMAI_DE_SESSION_STORE=sqlite         # memory | sqlite | redis  [not read yet: lands with F2/F3]
UMAI_DE_REDIS_URL=  [not read yet: lands with F2/F3]

# --- policy bundles (ADR-0012) ---
UMAI_DE_POLICY_DIR=policies
UMAI_DE_REQUIRE_SIGNED_BUNDLES=      # empty → false in development, true otherwise
UMAI_DE_BUNDLE_PUBLIC_KEYS=          # JSON: {"key_id": "base64 Ed25519 public key"}
UMAI_DE_BUNDLE_POLL_INTERVAL_S=5
