# Names of every setting the engine reads. No values here; copy to .env and fill locally.
# .env is git-ignored and agents are denied read access to it.

# --- process ---
UMAI_DE_ENV=development
UMAI_DE_LOG_LEVEL=INFO
UMAI_DE_MAX_TIMEOUT_MS=3000
UMAI_DE_DEFAULT_TIMEOUT_MS=1500
UMAI_DE_ALLOW_INLINE_BUNDLES=          # empty → true only in development
UMAI_DE_EXPOSE_DETECT_ENDPOINT=        # empty → true only in development
UMAI_DE_API_TOKEN=                     # shared operator token for /v1 (ADR-0016; self-hosted). Outside development
                                       # this or UMAI_DE_KEY_REGISTRY_DIR must be set
UMAI_DE_KEY_REGISTRY_DIR=              # per-tenant signed key snapshots written by the policy service (ADR-0023)
UMAI_DE_KEY_REGISTRY_POLL_INTERVAL_S=5
UMAI_DE_REGION=sh                      # eu | us | sh; stamped into new API keys
UMAI_DE_RATE_LIMIT_RPS=20              # per credential (ADR-0023 §7); empty disables
UMAI_DE_RATE_LIMIT_BURST=40

# --- policy service (control plane, ADR-0022; separate process) ---
UMAI_DE_CONTROL_API_TOKEN=            # bearer token for the policy service; required outside development
UMAI_DE_CONTROL_DB_PATH=.data/control.sqlite   # SQLite tenant store when DATABASE_URL is unset (ADR-0025 §7)
UMAI_DE_DATABASE_URL=                 # postgresql+asyncpg://umai_app:…@host/umai (application role, no BYPASSRLS)
UMAI_DE_DATABASE_ADMIN_URL=           # owner role, migrations only (deploy/postgres-init.sql creates umai_app)
UMAI_DE_DEFAULT_TENANT_ID=default     # tenant for control-plane requests without X-Umai-Tenant
UMAI_DE_SIGNING_KEY_FILE=             # Ed25519 private key file (base64) used to sign published versions
UMAI_DE_SIGNING_KEY_ID=

# --- L0 ---
UMAI_DE_TENANT_HMAC_KEYS=            # JSON map tenant_id -> base64 key (dev only; KMS later)
REGEX_TIMEOUT_SECONDS=1              # read by Presidio; integer only
HF_HUB_OFFLINE=1                     # never download models at runtime
UMAI_DE_L0_THREADS=4
UMAI_DE_L0_CACHE_ENTRIES=20000       # per-message detection cache (ADR-0037); 0 disables
UMAI_DE_POPULAR_DOMAINS_FILE=        # optional larger popular-domain list for UNKNOWN_LINK (one domain or rank,domain per line)

# --- Gateway (ADR-0034) ---
UMAI_DE_GATEWAY_MAX_INPUT_CHARS=256000  # characters scanned per call: the whole conversation

# --- L1b decision models (provider registry) ---
UMAI_DE_DECISION_PROVIDERS=          # JSON: {"openai": {"adapter": "openai_decisions", "base_url": "https://api.openai.com/v1", "model": "gpt-6-luna"}} (ADR-0040; adapters: openai_decisions, fake)
UMAI_DE_DECISION_PROVIDER_KEYS=      # JSON: {"openai": "<key>"}; never in bundles, never logged
UMAI_DE_DECISION_WARM_UP_TIMEOUT_MS=2000  # one synthetic request per provider at startup; 0 = off (ADR-0040 amendment)
UMAI_DE_DECISION_KEEPALIVE_S=120     # idle provider connections kept this long (httpx default: 5 s)
TYPESAFE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- L2 asynchronous review worker ---
UMAI_DE_L2_MODELS=                   # JSON: {"gpt_oss_safeguard_20b": {"base_url": "...", "model": "...", "auth_env": "..."}}  [not read yet: lands with F2/F3]
UMAI_DE_RECORDS_SINK=none            # none | database: decision events, L1b outcomes and usage to the tenant store (ADR-0041); database needs UMAI_DE_DATABASE_URL (application role)
UMAI_DE_RECORDS_QUEUE_SIZE=10000     # in-memory queue; when full a record is dropped and counted, never a decision delayed (ADR-0042)
UMAI_DE_RECORDS_DECISION_RETENTION_DAYS=30   # policy service: decision events and L1b outcomes deleted after this (ADR-0041 §5)
UMAI_DE_RECORDS_USAGE_RETENTION_DAYS=400     # policy service: usage ledger
UMAI_DE_L2_WORKER_CONCURRENCY=2  [not read yet: lands with F2/F3]
UMAI_DE_L2_CALL_TIMEOUT_S=30  [not read yet: lands with F2/F3]

# --- session history ---
UMAI_DE_SESSION_STORE=sqlite         # memory | sqlite | redis  [not read yet: lands with F2/F3]
UMAI_DE_REDIS_URL=  [not read yet: lands with F2/F3]

# --- policy bundles (ADR-0012) ---
UMAI_DE_POLICY_DIR=policies
UMAI_DE_REQUIRE_SIGNED_BUNDLES=      # empty → false in development, true otherwise
UMAI_DE_BUNDLE_PUBLIC_KEYS=          # JSON: {"key_id": "base64 Ed25519 public key"}
UMAI_DE_BUNDLE_POLL_INTERVAL_S=5
