# One hostname (Azure DNS label or a custom domain): the engine API on /v1, /healthz, /readyz;
# /brand/* (public brand files for Auth0's login page and e-mails); everything else is the
# console, which signs people in itself (OIDC, ADR-0024), optionally behind basic auth too.
{
	# No ACME account e-mail: Let's Encrypt does not require one (expiry mails are optional).
	servers {
		protocols h1 h2 h3
	}
}

{$UMAI_HOSTNAME} {
	tls {
		protocols tls1.2 tls1.3
	}

	# Defaults for responses that bring none ("?": only when the upstream did not set the
	# header): the engine API gets these; the console sends its own, with a per-request CSP
	# nonce (umai-control-center src/lib/security-headers.ts, ADR-0024 §2), and keeps them.
	# One directive per field: "?" fields in one block share one condition (all absent), so a
	# single header from the upstream would cancel every default.
	header ?Strict-Transport-Security "max-age=31536000"
	header ?X-Content-Type-Options "nosniff"
	header ?Referrer-Policy "no-referrer"
	header ?Content-Security-Policy "frame-ancestors 'none'"
	header -Server

	# Ingress body cap (ADR-0019 §4) until the engine enforces its own prompt-size limit. Gateway
	# calls carry a whole conversation (up to 256 000 scanned characters, gateway-api 0.8), JSON-
	# escaped, plus tool definitions: 4 MB for those paths.
	@gateway path /v1/chat/completions /v1/responses /v1/embeddings /v1/models
	request_body @gateway {
		max_size 4MB
	}
	@not_gateway not path /v1/chat/completions /v1/responses /v1/embeddings /v1/models
	request_body @not_gateway {
		max_size 512KB
	}

	# OpenAPI and docs are development aids (gap analysis 13.4.5); not served here.
	@docs path /docs /docs/* /redoc /openapi.json
	handle @docs {
		respond 404
	}

	# UMAI gateway (ADR-0034; Compose profile "gateway"): the OpenAI-compatible paths. Before
	# @engine, which owns the rest of /v1. Streams are flushed as they arrive. Without the profile
	# these paths answer 502. (@gateway is defined with the body caps above.)
	handle @gateway {
		header Cache-Control "no-store"
		reverse_proxy gateway:9300 {
			flush_interval -1
		}
	}

	# iyzico's subscription notifications (ADR-0044 D5): the one path of the policy service that is
	# reachable from outside. No token: each notification carries an X-IYZ-SIGNATURE-V3 the policy
	# service verifies. Everything else of the policy service stays internal.
	@hooks path /hooks/iyzico
	handle @hooks {
		header Cache-Control "no-store"
		reverse_proxy policy:9200
	}

	@engine path /v1/* /healthz /readyz
	handle @engine {
		header Cache-Control "no-store"
		reverse_proxy engine:9100
	}

	# Brand kit files (logos, icons, fonts) without basic auth: Auth0's hosted login page and the
	# e-mails load them from here in the visitor's browser. Public brand files only; the console's
	# middleware also serves them without a session. Fonts need CORS for a cross-origin page.
	@brand path /brand/*
	handle @brand {
		header /brand/fonts/* Access-Control-Allow-Origin "*"
		reverse_proxy console:3100 {
			# Replace the console's own Cache-Control (max-age=0) instead of adding a second one.
			header_down Cache-Control "public, max-age=86400"
		}
	}

	handle {
		# basic_auth when UMAI_CONSOLE_BASIC_AUTH=true, else a no-op; written by umai.sh into tmpfs.
		import /run/umai/console-gate.caddy
		reverse_proxy console:3100
	}

	log {
		# Access log without query strings or headers (no content, no credentials).
		format filter {
			request>uri query {
				delete *
			}
			request>headers delete
			request>tls delete
			resp_headers delete
		}
	}
}
