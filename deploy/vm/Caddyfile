# One hostname (Azure DNS label or a custom domain): the engine API on /v1, /healthz, /readyz;
# /brand/* (public brand files for Auth0's login page and e-mails); everything else is the
# console, which signs people in itself (OIDC, ADR-0024), optionally behind basic auth too.
{
	# No ACME account e-mail: Let's Encrypt does not require one (expiry mails are optional).
	servers {
		protocols h1 h2 h3
	}
}

{$UMAI_HOSTNAME} {
	tls {
		protocols tls1.2 tls1.3
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}

	# Ingress body cap (ADR-0019 §4) until the engine enforces its own prompt-size limit.
	request_body {
		max_size 512KB
	}

	# OpenAPI and docs are development aids (gap analysis 13.4.5); not served here.
	@docs path /docs /docs/* /redoc /openapi.json
	handle @docs {
		respond 404
	}

	@engine path /v1/* /healthz /readyz
	handle @engine {
		header Cache-Control "no-store"
		reverse_proxy engine:9100
	}

	# Brand kit files (logos, icons, fonts) without basic auth: Auth0's hosted login page and the
	# e-mails load them from here in the visitor's browser. Public brand files only; the console's
	# middleware also serves them without a session. Fonts need CORS for a cross-origin page.
	@brand path /brand/*
	handle @brand {
		header /brand/fonts/* Access-Control-Allow-Origin "*"
		reverse_proxy console:3100 {
			# Replace the console's own Cache-Control (max-age=0) instead of adding a second one.
			header_down Cache-Control "public, max-age=86400"
		}
	}

	handle {
		# basic_auth when UMAI_CONSOLE_BASIC_AUTH=true, else a no-op; written by umai.sh into tmpfs.
		import /run/umai/console-gate.caddy
		reverse_proxy console:3100
	}

	log {
		# Access log without query strings or headers (no content, no credentials).
		format filter {
			request>uri query {
				delete *
			}
			request>headers delete
			request>tls delete
			resp_headers delete
		}
	}
}
