# One hostname (Azure DNS label or a custom domain): the engine API on /v1, /healthz, /readyz;
# /brand/* (public brand files for Auth0's login page and e-mails); everything else is the
# console, which signs people in itself (OIDC, ADR-0024), optionally behind basic auth too.
#
# Every file Caddy reads is in /etc/caddy, one directory mount written by umai.sh, so a changed
# file takes effect with a reload rather than a restart.
{
	# No ACME account e-mail: Let's Encrypt does not require one (expiry mails are optional).
	servers {
		protocols h1 h2 h3
	}
}

# Zero-downtime deploys (ADR-0052): a request goes to any running container of the service
# ({args[0]}), found in Docker's DNS every second, so a new container takes requests once it
# listens and Caddy is never reloaded for a deploy. A starting container, and one told to stop,
# refuse connections; a refused connection (or one to a container gone a moment ago) is tried
# again on another container for up to 5 s, for every method, since nothing was sent. Caddy
# 2.11.4 or later keeps the request body for that retry (2.10 sent it empty). No idle
# connections to containers: a kept one could be closed by a stopping container just as a
# request is sent on it, and that request could not be retried.
(upstream) {
	dynamic a {args[0]} {args[1]} {
		refresh 1s
	}
	lb_try_duration 5s
	lb_try_interval 50ms
	transport http {
		keepalive off
		dial_timeout 500ms
	}
}

{$UMAI_HOSTNAME} {
	tls {
		protocols tls1.2 tls1.3
	}

	# Defaults for responses that bring none ("?": only when the upstream did not set the
	# header): the engine API gets these; the console sends its own, with a per-request CSP
	# nonce (umai-control-center src/lib/security-headers.ts, ADR-0024 §2), and keeps them.
	# One directive per field: "?" fields in one block share one condition (all absent), so a
	# single header from the upstream would cancel every default.
	header ?Strict-Transport-Security "max-age=31536000"
	header ?X-Content-Type-Options "nosniff"
	header ?Referrer-Policy "no-referrer"
	header ?Content-Security-Policy "frame-ancestors 'none'"
	header -Server

	# Ingress body cap (ADR-0019 §4) until the engine enforces its own prompt-size limit. Gateway
	# calls carry a whole conversation (up to 256 000 scanned characters, gateway-api 0.8), JSON-
	# escaped, plus tool definitions: 4 MB for those paths.
	@gateway path /v1/chat/completions /v1/responses /v1/embeddings /v1/models
	request_body @gateway {
		max_size 4MB
	}
	@not_gateway not path /v1/chat/completions /v1/responses /v1/embeddings /v1/models
	request_body @not_gateway {
		max_size 512KB
	}

	# Customer API documentation (ADR-0054): static files of the running release, copied by the
	# seed. FastAPI's own documentation stays closed: it lists internal routes (gap 13.4.5).
	@fastapi_docs path /redoc /openapi.json
	handle @fastapi_docs {
		respond 404
	}
	redir /docs /docs/ 308
	handle_path /docs/* {
		root * /srv/docs
		header Cache-Control "public, max-age=300"
		header Content-Security-Policy "default-src 'none'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		file_server
	}

	# UMAI gateway (ADR-0034; Compose profile "gateway"): the OpenAI-compatible paths. Before
	# @engine, which owns the rest of /v1. Streams are flushed as they arrive. Without the profile
	# these paths answer 502. (@gateway is defined with the body caps above.)
	handle @gateway {
		header Cache-Control "no-store"
		reverse_proxy {
			import upstream gateway 9300
			flush_interval -1
		}
	}

	# iyzico's subscription notifications (ADR-0044 D5): the one path of the policy service that is
	# reachable from outside. No token: each notification carries an X-IYZ-SIGNATURE-V3 the policy
	# service verifies. Everything else of the policy service stays internal.
	@hooks path /hooks/iyzico
	handle @hooks {
		header Cache-Control "no-store"
		reverse_proxy {
			import upstream policy 9200
		}
	}

	@engine path /v1/* /healthz /readyz
	handle @engine {
		header Cache-Control "no-store"
		reverse_proxy {
			import upstream engine 9100
		}
	}

	# The console serves no WebSocket, so upgrade requests stop here. Next.js 14 proxied them to any
	# host (GHSA-c4j6-fc7j-m34r, SSRF); the console runs Next.js 15.5.28 since 2026-10-31, and this
	# stays as defence in depth (ADR-0049).
	@upgrade header Upgrade *

	# Brand kit files (logos, icons, fonts) without basic auth: Auth0's hosted login page and the
	# e-mails load them from here in the visitor's browser. Public brand files only; the console's
	# middleware also serves them without a session. Fonts need CORS for a cross-origin page.
	@brand path /brand/*
	handle @brand {
		respond @upgrade 400
		header /brand/fonts/* Access-Control-Allow-Origin "*"
		reverse_proxy {
			import upstream console 3100
			# Replace the console's own Cache-Control (max-age=0) instead of adding a second one.
			header_down Cache-Control "public, max-age=86400"
		}
	}

	handle {
		respond @upgrade 400
		# basic_auth when UMAI_CONSOLE_BASIC_AUTH=true, else a no-op; written by umai.sh into tmpfs.
		import /etc/caddy/console-gate.caddy
		reverse_proxy {
			import upstream console 3100
		}
	}

	log {
		# Access log without query strings or headers (no content, no credentials).
		format filter {
			request>uri query {
				delete *
			}
			request>headers delete
			request>tls delete
			resp_headers delete
		}
	}
}

# Internal entry points for the console's server-side calls (UMAI_ENGINE_URL, UMAI_CONTROL_URL in
# docker-compose.yml): not published, reachable on the Compose network only, as the services
# themselves are. Through Caddy the console gets the same retries during a deploy (ADR-0052).
http://:9100 {
	reverse_proxy {
		import upstream engine 9100
	}
}

http://:9200 {
	reverse_proxy {
		import upstream policy 9200
	}
}
