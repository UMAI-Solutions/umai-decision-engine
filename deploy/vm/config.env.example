# Non-secret settings for the single-VM stack. Copy to /opt/umai/config.env on the VM.
# Secrets: Key Vault (UMAI_KEY_VAULT) or /opt/umai/secrets.env from `umai.sh init` (ADR-0032 §5).

UMAI_HOSTNAME=                 # e.g. umai-beta.westeurope.cloudapp.azure.com (Bicep output) or a custom domain
UMAI_KEY_VAULT=                # Key Vault name (Bicep output); empty -> /opt/umai/secrets.env (umai.sh init)
UMAI_BACKUP_ACCOUNT=           # storage account name (Bicep output)
UMAI_CONSOLE_USER=             # basic-auth user for the console (until ADR-0024 login)
UMAI_CONSOLE_TENANT_ID=console
UMAI_CONSOLE_SRC=/opt/umai/src/umai-control-center
UMAI_SIGNING_KEY_ID=           # e.g. vm-2026-10
UMAI_BUNDLE_PUBLIC_KEYS=       # JSON {"<key id>": "<base64 Ed25519 public key>"}; public, not secret
