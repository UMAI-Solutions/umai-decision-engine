# Non-secret settings for the single-VM stack. Copy to /opt/umai/config.env on the VM.
# Secrets: Key Vault (UMAI_KEY_VAULT) or /opt/umai/secrets.env from `umai.sh init` (ADR-0032 §5).

UMAI_HOSTNAME=                 # e.g. umai-beta.westeurope.cloudapp.azure.com (Bicep output) or a custom domain
UMAI_KEY_VAULT=                # Key Vault name (Bicep output); empty -> /opt/umai/secrets.env (umai.sh init)
UMAI_BACKUP_ACCOUNT=           # storage account name (Bicep output)
UMAI_CONSOLE_BASIC_AUTH=true   # changing it restarts Caddy at the next umai.sh up; true: Caddy's basic auth in front of the console as well; false: only the console's sign-in
UMAI_CONSOLE_USER=             # basic-auth user (with UMAI_CONSOLE_BASIC_AUTH=true)
UMAI_OIDC_ISSUER=              # console sign-in: e.g. https://<tenant>.us.auth0.com/ (README §3a)
UMAI_OIDC_CLIENT_ID=           # the console's Auth0 application (Terraform output console_client_id)
UMAI_ACTOR_KEY_ID=console-1    # key id of the console's assertion key (generated by umai.sh)
UMAI_CONSOLE_TENANT_ID=console
UMAI_CONSOLE_SRC=/opt/umai/src/umai-control-center
UMAI_REGION=sh                 # eu | us | sh: stamped into API keys minted here (ADR-0023)
UMAI_SIGNING_KEY_ID=           # e.g. vm-2026-10
UMAI_BUNDLE_PUBLIC_KEYS=       # JSON {"<key id>": "<base64 Ed25519 public key>"}; public, not secret
UMAI_PLANS=false               # true: plans and monthly quotas from the image's /app/plans.yaml (Community 10 000 requests/month; ADR-0043); false: none
UMAI_BILLING=none              # iyzico: sell paid plans (ADR-0044, README §7c); keys via umai.sh set-secret
UMAI_IYZICO_BASE_URL=          # empty: the sandbox; live: https://api.iyzipay.com
UMAI_IYZICO_MERCHANT_ID=
UMAI_BILLING_PLAN_REFS=        # {"pro":"<pricing plan reference>"} from billing.cli sync
UMAI_GATEWAY=false             # true: run the UMAI gateway on /v1/chat/completions, /v1/responses, /v1/embeddings, /v1/models (README §7)
UMAI_APPLICATIONS=/opt/umai/applications   # one <tenant>.yaml: applications, providers (gateway-api 0.10)
UMAI_GATEWAY_UPSTREAM_ALLOWLIST=  # optional JSON list replacing the default (OpenAI, Azure OpenAI over https)
UMAI_DECISION_PROVIDERS=       # optional JSON replacing the L1b provider entry (README §7a); default: OpenAI, gpt-6-luna, US endpoint
