              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayErrorBody"
                }
              }
            }
          },
          "504": {
            "description": "`upstream_timeout`: the provider did not answer in time.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayErrorBody"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Umai-Application",
            "in": "header",
            "required": false,
            "description": "The application to call as. Needed only when the key belongs to no application and the organization has several; a key that belongs to an application uses that one.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Umai-Provider-Key",
            "in": "header",
            "required": false,
            "description": "Your provider's API key (e.g. OpenAI's), when the provider is set up with your own key (`pass_through`, the built-in OpenAI provider). Sent to the provider only; never stored, logged or echoed.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Umai-Request-Id",
            "in": "header",
            "required": false,
            "description": "Your id for the call (at most 128 characters); generated when absent and returned in the response header of the same name.",
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "name": "X-Umai-Session-Id",
            "in": "header",
            "required": false,
            "description": "Your id for the conversation.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Umai-Subject-User",
            "in": "header",
            "required": false,
            "description": "Your pseudonymous id for the person; falls back to the body's `safety_identifier`, then `user`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Umai-Subject-Role",
            "in": "header",
            "required": false,
            "description": "The person's role, for policies that use it.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Umai-Subject-Department",
            "in": "header",
            "required": false,
            "description": "The person's department, for policies that use it.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Umai-Agent-Id",
            "in": "header",
            "required": false,
            "description": "Your id for the AI agent making the call.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "An OpenAI embeddings request.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "The model, as your application sends it. An alias or `@<provider>/<model>` picks a provider the organization connected; other names go to the default provider.",
                    "examples": [
                      "gpt-4.1-mini"
                    ]
                  },
                  "input": {
                    "description": "A string or an array of strings; each one is checked."
                  }
                },
                "additionalProperties": true
              },
              "examples": {
                "texts": {
                  "summary": "Two passages for a search index",
                  "value": {
                    "model": "text-embedding-3-small",
                    "input": [
                      "Müşteri hizmetleri hafta içi 09:00-18:00 arası açıktır.",
                      "İade talebi için 10000000146 numaralı başvuruyu kullanın."
                    ]
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "UmaiKey": []
          }
        ]
      }
    },
