                        "type": "umai_guardrail",
                        "code": "umai_blocked",
                        "umai": {
                          "request_id": "gw-3f9c1e0b",
                          "event_id": "ta-195c97496f4748b88442e60f6ed6e1b9",
                          "phase": "PRE_LLM",
                          "action": "BLOCK",
                          "entities": [
                            "TR_TCKN"
                          ],
                          "matched": [
                            "identity-data"
                          ]
                        }
                      }
                    }
                  },
                  "provider_key_required": {
                    "value": {
                      "error": {
                        "message": "this provider needs your provider key in the X-Umai-Provider-Key header",
                        "type": "umai_gateway",
                        "code": "provider_key_required"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/GatewayErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "`invalid_credential`: missing, unknown, expired or revoked UMAI key.",
            "content": {
              "application/json": {
                "examples": {
                  "invalid_credential": {
                    "value": {
                      "error": {
                        "message": "missing or invalid API credential",
                        "type": "umai_gateway",
                        "code": "invalid_credential"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/GatewayErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`ip_not_allowed`, `insufficient_scope`, `application_mismatch` or `provider_not_allowed`.",
            "content": {
              "application/json": {
                "examples": {
                  "ip_not_allowed": {
                    "value": {
                      "error": {
                        "message": "this key may not be used from this address",
                        "type": "umai_gateway",
                        "code": "ip_not_allowed"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/GatewayErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "`unknown_application`, `unknown_provider` or `model_not_allowed`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayErrorBody"
                }
              }
