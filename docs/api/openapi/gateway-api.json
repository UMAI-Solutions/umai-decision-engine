                "description": "Seconds to wait before the next attempt.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayErrorBody"
                }
              }
            }
          },
