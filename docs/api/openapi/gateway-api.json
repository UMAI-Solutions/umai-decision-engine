        "operationId": "create_response_v1_responses_post",
        "responses": {
          "200": {
            "description": "The provider's response object (or Responses events when streaming), after the answer checks.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "headers": {
              "X-Umai-Request-Id": {
                "description": "The call's id; quote it when you contact support.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Umai-Application": {
                "description": "The application the call ran as.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Umai-Event-Id": {
                "description": "The recorded decision of the input check.",
                "schema": {
                  "type": "string"
