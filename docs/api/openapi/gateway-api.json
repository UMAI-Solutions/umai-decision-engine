  "components": {
    "schemas": {
      "Action": {
        "type": "string",
        "enum": [
          "ALLOW",
          "ALLOW_WITH_WARNINGS",
          "ALLOW_WITH_MODIFICATIONS",
          "STEP_UP_APPROVAL",
          "BLOCK"
        ],
        "title": "Action"
      },
      "GatewayError": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "enum": [
              "umai_guardrail",
              "umai_gateway"
            ],
            "title": "Type"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Param"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "umai": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UmaiDecisionInfo"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message",
          "type",
          "code"
        ],
        "title": "GatewayError"
      },
      "GatewayErrorBody": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/GatewayError"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "GatewayErrorBody",
        "description": "OpenAI-shaped error body for refusals and gateway errors."
      },
      "Phase": {
        "type": "string",
        "enum": [
          "PRE_LLM",
          "POST_LLM",
          "TOOL_INPUT",
          "TOOL_OUTPUT",
          "MCP_REQUEST",
          "MCP_RESPONSE",
          "MEMORY_WRITE"
        ],
        "title": "Phase"
      },
      "UmaiDecisionInfo": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "event_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id"
          },
          "phase": {
            "$ref": "#/components/schemas/Phase"
          },
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "entities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Entities"
          },
          "matched": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matched"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "phase",
          "action"
        ],
        "title": "UmaiDecisionInfo",
        "description": "Why the gateway refused: ids, types and actions only, never content."
      }
    },
    "securitySchemes": {
      "UmaiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "An API key from the console: `umai_<env>_<region>_<key_id>_<secret>`. Server side only; never in a browser or a mobile app."
      }
    }
  },
  "tags": [
    {
      "name": "AI gateway",
      "description": "OpenAI-compatible calls through your guardrail."
    }
  ],
  "servers": [
    {
      "url": "https://{host}",
      "description": "Your UMAI address; the console shows it under API & SDKs.",
      "variables": {
        "host": {
          "default": "umai.example"
        }
      }
    }
  ]
}
